# Backend (private)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio WhatsApp — required for lead notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# Tavily web search — public / current facts
TAVILY_API_KEY=

# Dev panel — required in production; protects /api/dev/* and /api/knowledge/*
DEV_PANEL_SECRET=

# Weekly LinkedIn bio sync (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# LinkedIn About/Bio sync — URL is metadata only; pages are never scraped
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/ddavid37/
# file | url | mock
LINKEDIN_BIO_SOURCE=
# When SOURCE=file: path to an About/Bio export you control
LINKEDIN_BIO_FILE=
# When SOURCE=url: authorized export URL you control (not linkedin.com)
LINKEDIN_BIO_EXPORT_URL=

# Frontend (public — also set in Vercel frontend project)
NEXT_PUBLIC_API_URL=http://localhost:8000
